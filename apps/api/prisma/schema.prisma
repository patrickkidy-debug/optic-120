// OculoSaaS — Schéma Prisma (Phase 1)
// Multi-tenant par colonne tenantId + isolation forcée via Prisma Client Extension.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ---------------- TENANCY ----------------
 */

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Tenant {
  id                String       @id @default(uuid())
  name              String
  slug              String       @unique
  logoUrl           String?
  // Situation géographique de l'établissement (adresse ou lien de carte).
  location          String?
  // Contact de l'entreprise (affichable sur les documents).
  contactPhone      String?
  contactEmail      String?
  // Personnalisation des documents (factures/devis) : couleur d'accent, mentions
  // légales, note de bas de page, validité des devis. null = valeurs par défaut.
  invoiceSettings   Json?
  // Numéro WhatsApp du responsable de l'établissement, collecté à l'inscription
  // (obligatoire côté formulaire) pour permettre au fondateur de le contacter.
  whatsappPhone     String?
  status            TenantStatus @default(ACTIVE)
  currency          String       @default("XOF")
  countryCode       String? // ISO-2, déduit de l'indicatif WhatsApp à l'inscription
  // Taux de TVA en pourcentage (0 = exonéré). null = défaut 18 %.
  vatRate           Float?
  // Tarifs verres/traitements propres à l'établissement (configurateur). null = barème par défaut.
  lensPricing       Json?
  // Investissement initial, pour la projection d'amortissement (page Finance).
  initialInvestment Float?
  // Modèles de messages WhatsApp par étape de vente.
  whatsappTemplates Json?
  // Config CinetPay (apiKey chiffrée au repos). null = mode simulation par défaut.
  paymentConfig     Json?
  // Réglages métier optique : validité des ordonnances, seuils de relance,
  // garantie par défaut, valeur du point de fidélité. null = valeurs par défaut.
  opticalSettings   Json?
  // Établissement fictif créé par "Découvrir OculoSaaS" (visite guidée pour
  // prospects) : produits/patients/ventes factices, exclu des statistiques
  // plateforme (MRR, nouveaux établissements). Repasse à false et perd toutes
  // ses données factices (purgeDemoData) au moment d'un paiement réel.
  isDemo            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  demoProgress      DemoProgress?
  storeSetupProgress StoreSetupProgress?
  branches          Branch[]
  users             User[]
  roles             Role[]
  products          Product[]
  stockItems        StockItem[]
  stockMovements    StockMovement[]
  customers         Customer[]
  prescriptions     OpticalPrescription[]
  sales             Sale[]
  payments          Payment[]
  cashRegisters     CashRegister[]
  auditLogs         AuditLog[]
  patients          Patient[]
  consultations     Consultation[]
  appointments      Appointment[]
  surgeries         Surgery[]
  employees         Employee[]
  expenses          Expense[]
  cashTransfers     CashTransfer[]
  suppliers         Supplier[]
  insurers          Insurer[]
  lensOrders        LensOrder[]
  repairs           Repair[]
  subscription      Subscription?
  subInvoices       SubscriptionInvoice[]
  inventoryCounts   InventoryCount[]
  stockTransfers    StockTransfer[]
  demoVideoProgress DemoVideoProgress[]
}

/// Progression de la visite guidée démo (tenant isDemo). Persistée côté
/// serveur (pas seulement localStorage) pour survivre à un changement
/// d'appareil/navigateur : "vous étiez à l'étape 3, continuer ?".
model DemoProgress {
  id            String    @id @default(uuid())
  tenantId      String    @unique
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentStepId String?
  completedAt   DateTime?
  skipped       Boolean   @default(false)
  /// Identifiants des données d'exemple pré-remplies à l'inscription sur un
  /// compte réel (voir seedSampleBusinessData/purgeSampleData) ; null une fois
  /// purgées ou sur un tenant jamais semé (ex. l'ancien flux démo isDemo).
  seedManifest  Json?
  updatedAt     DateTime  @updatedAt
}

/// Progression de l'assistant "Configuration de la boutique" (checklist des 8
/// étapes d'installation réelle : infos boutique, équipe, produits, stock,
/// paiements, clients, documents, vérification finale). Le statut de chaque
/// étape N'EST PAS stocké ici : il est recalculé à la volée depuis les vraies
/// données (voir store-setup.service.ts) pour que les boutiques déjà
/// existantes n'aient jamais l'impression de devoir tout refaire. Seules les
/// exceptions manuelles (étape ignorée / forcée) et l'accusé de fin sont
/// persistés.
model StoreSetupProgress {
  id            String    @id @default(uuid())
  tenantId      String    @unique
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// { [stepKey]: "completed" | "skipped" } — exceptions manuelles uniquement.
  stepOverrides Json      @default("{}")
  /// Rempli quand l'utilisateur clique "Commencer à utiliser OculoSaaS" sur
  /// l'étape finale : c'est ce qui masque la carte du Dashboard (pas le calcul
  /// de progression lui-même), pour garder un vrai moment de conclusion.
  finishedAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model Branch {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockItems      StockItem[]
  sales           Sale[]
  cashRegisters   CashRegister[]
  users           UserBranch[]
  inventoryCounts InventoryCount[]
  transfersFrom   StockTransfer[]  @relation("TransfersFrom")
  transfersTo     StockTransfer[]  @relation("TransfersTo")

  @@index([tenantId])
}

/**
 * ---------------- IDENTITY & RBAC ----------------
 */

model User {
  id                   String    @id @default(uuid())
  tenantId             String
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                String
  username             String?
  passwordHash         String
  firstName            String
  lastName             String
  phone                String?
  photoUrl             String?
  isActive             Boolean   @default(true)
  lastLoginAt          DateTime?
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  googleId             String?   @unique // identifiant Google (sub) si connecté via "Se connecter avec Google"
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String? // secret TOTP chiffré (AES-256-GCM)
  preferences          Json? // { theme: 'light'|'dark'|'auto', locale: 'fr'|'en'|'pt', ... }
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  roleId                   String
  role                     Role                 @relation(fields: [roleId], references: [id])
  branches                 UserBranch[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  sales                    Sale[]
  startedInventoryCounts   InventoryCount[]     @relation("InventoryCountStartedBy")
  completedInventoryCounts InventoryCount[]     @relation("InventoryCountCompletedBy")
  countedInventoryLines    InventoryCountLine[] @relation("InventoryCountLineCountedBy")
  demoVideoProgress        DemoVideoProgress[]
  createdTransfers         StockTransfer[]      @relation("TransferCreatedBy")
  confirmedTransfers       StockTransfer[]      @relation("TransferConfirmedBy")

  @@unique([tenantId, email])
  @@unique([tenantId, username])
  @@index([tenantId])
}

model UserBranch {
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@index([branchId])
}

model Role {
  id                    String   @id @default(uuid())
  tenantId              String? // null = rôle système/template global
  tenant                Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                  String // identifiant stable (ex: "admin", "caissier")
  name                  String // libellé affiché
  isSystem              Boolean  @default(false)
  isCustom              Boolean  @default(false)
  allBranches           Boolean  @default(false)
  // true dès qu'un admin modifie les permissions du rôle : le resync des rôles
  // système (seed au déploiement) NE DOIT PAS écraser un rôle personnalisé.
  permissionsCustomized Boolean  @default(false)
  createdAt             DateTime @default(now())

  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id     String @id @default(uuid())
  module String
  action String
  label  String

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

/**
 * ---------------- CATALOG / STOCK ----------------
 */

enum ProductCategory {
  MONTURE
  VERRE
  LENTILLE
  ACCESSOIRE
  /// Produits d'entretien (sprays, lingettes, solutions lentilles…)
  ENTRETIEN
  SERVICE
  /// Divers, hors des familles ci-dessus
  AUTRE
}

model Product {
  id         String          @id @default(uuid())
  tenantId   String
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku        String
  category   ProductCategory
  brand      String?
  name       String
  attributes Json?
  /// Photo principale (data URL redimensionnée) : donnée centrale du catalogue
  /// visuel, chargée avec la liste.
  photoUrl   String?
  /// Photos secondaires (tableau de data URLs). Volontairement EXCLUE des
  /// listes : on ne la charge que sur la fiche produit.
  photos     Json?
  buyPrice   Decimal         @db.Decimal(12, 2)
  sellPrice  Decimal         @db.Decimal(12, 2)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  stockItems          StockItem[]
  saleItems           SaleItem[]
  lensOrders          LensOrder[]
  inventoryCountLines InventoryCountLine[]
  stockTransferLines  StockTransferItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, category])
}

model StockItem {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quantity  Int      @default(0)
  minAlert  Int      @default(0)
  /// Emplacement physique libre (« Vitrine A », « Réserve »…) — jamais obligatoire.
  location  String?
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@unique([productId, branchId])
  @@index([tenantId, branchId])
  @@index([tenantId])
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT
  RETURN_IN
  TRANSFER
}

model StockMovement {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem         @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Int // signé : +entrée, -sortie
  reason      String?
  saleId      String?
  // Réception fournisseur : origine et coût d'achat unitaire, pour tracer
  // les entrées de stock (PURCHASE_IN) et suivre les prix d'achat.
  supplierId  String?
  supplier    Supplier?         @relation(fields: [supplierId], references: [id])
  unitCost    Decimal?          @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, stockItemId])
  @@index([tenantId])
  @@index([supplierId])
}

enum StockTransferStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Demande de transfert de stock entre deux magasins (nécessite confirmation de réception).
model StockTransfer {
  id            String              @id @default(uuid())
  tenantId      String
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number        String
  fromBranchId  String
  fromBranch    Branch              @relation("TransfersFrom", fields: [fromBranchId], references: [id])
  toBranchId    String
  toBranch      Branch              @relation("TransfersTo", fields: [toBranchId], references: [id])
  status        StockTransferStatus @default(PENDING)
  reason        String?
  createdById   String?
  createdBy     User?               @relation("TransferCreatedBy", fields: [createdById], references: [id])
  confirmedById String?
  confirmedBy   User?               @relation("TransferConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items StockTransferItem[]

  @@unique([tenantId, number])
  @@index([tenantId, fromBranchId])
  @@index([tenantId, toBranchId])
  @@index([tenantId, status])
}

model StockTransferItem {
  id         String        @id @default(uuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int

  @@index([transferId])
}

enum InventoryCountStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InventoryAdjustmentReason {
  PHYSICAL_INVENTORY
  BREAKAGE
  LOSS
  THEFT
  ENTRY_ERROR
  GIFT
  INVENTORY_ERROR
  OTHER
}

/// Session d'inventaire physique : compter -> valider -> régulariser les écarts choisis.
model InventoryCount {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String
  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  status        InventoryCountStatus @default(DRAFT)
  /// Filtre utilisé à la création (catégorie/marque/emplacement) — informatif seulement.
  scopeCategory String?
  scopeBrand    String?
  scopeLocation String?
  note          String?
  startedById   String?
  startedBy     User?                @relation("InventoryCountStartedBy", fields: [startedById], references: [id])
  /// Posé quand le comptage est terminé (verrouille la saisie), avant la régularisation.
  validatedAt   DateTime?
  completedById String?
  completedBy   User?                @relation("InventoryCountCompletedBy", fields: [completedById], references: [id])
  completedAt   DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  lines InventoryCountLine[]

  @@index([tenantId, branchId, status])
}

/// Une ligne = un produit dans une session d'inventaire (quantité théorique figée à la création).
model InventoryCountLine {
  id               String                     @id @default(uuid())
  tenantId         String
  inventoryCountId String
  inventoryCount   InventoryCount             @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  productId        String
  product          Product                    @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Figée à la création de la session — jamais modifiée pendant le comptage.
  theoreticalQty   Int
  countedQty       Int?
  countedById      String?
  countedBy        User?                      @relation("InventoryCountLineCountedBy", fields: [countedById], references: [id])
  countedAt        DateTime?
  locationSnapshot String?
  /// Dénormalisés (recalculés à chaque saisie) pour que le résumé et les
  /// filtres par statut restent des agrégats SQL rapides à grande échelle,
  /// sans jamais charger toutes les lignes en mémoire.
  deltaQty         Int?
  deltaValue       Decimal?                   @db.Decimal(14, 2)
  regularized      Boolean                    @default(false)
  movementId       String?
  reason           InventoryAdjustmentReason?
  reasonNote       String?
  updatedAt        DateTime                   @updatedAt

  @@unique([inventoryCountId, productId])
  @@index([tenantId, inventoryCountId])
}

/**
 * ---------------- CUSTOMERS / SALES ----------------
 */

model Customer {
  id            String    @id @default(uuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  phone         String?
  email         String?
  // Fiche client complète : indispensable pour les relances (anniversaire,
  // renouvellement) et les conseils liés à l'âge (presbytie).
  dateOfBirth   DateTime?
  gender        Gender?
  address       String?
  profession    String?
  notes         String?
  loyaltyPoints Int       @default(0)
  createdAt     DateTime  @default(now())

  sales         Sale[]
  prescriptions OpticalPrescription[]
  lensOrders    LensOrder[]
  repairs       Repair[]
  patient       Patient?  @relation("CustomerPatient")

  @@index([tenantId])
}

model OpticalPrescription {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date              DateTime  @default(now())
  prescriberName    String?
  odSphere          String?
  odCylinder        String?
  odAxis            String?
  odAddition        String?
  ogSphere          String?
  ogCylinder        String?
  ogAxis            String?
  ogAddition        String?
  pupillaryDistance String?
  lensType          String?
  notes             String?
  // Mesures avancées de montage
  odHeight          String? // hauteur de montage OD (mm)
  ogHeight          String? // hauteur de montage OG (mm)
  odNearPd          String? // écart pupillaire de près OD (mm)
  ogNearPd          String? // écart pupillaire de près OG (mm)
  vertex            String? // distance verre-œil (mm)
  pantoTilt         String? // angle pantoscopique (°)
  /// Fin de validité de l'ordonnance (calculée à la création depuis les
  /// réglages de l'établissement, modifiable). Pilote les relances.
  expiresAt         DateTime?
  /// Photo / scan d'ordonnance papier (data URL redimensionnée)
  photoUrl          String?
  createdById       String?
  createdAt         DateTime  @default(now())

  sales Sale[]

  @@index([tenantId, customerId])
  @@index([tenantId])
}

enum SaleType {
  QUOTE
  SALE
  RETURN
}

/// Workflow Kanban des commandes de verres. MOUNTED est conservé (valeur
/// Postgres irréversible sans recréer le type) mais n'est plus produit :
/// les commandes existantes y ont été basculées vers READY par migration.
enum LensOrderStatus {
  TO_ORDER
  ORDERED
  LAB_CONFIRMED
  IN_PRODUCTION
  SHIPPED
  RECEIVED
  CONTROL
  MOUNTING
  MOUNTED
  READY
  DELIVERED
  CANCELLED
}

enum RepairStatus {
  RECEIVED
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Sale {
  id                String               @id @default(uuid())
  tenantId          String
  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch               @relation(fields: [branchId], references: [id])
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id])
  cashierId         String
  cashier           User                 @relation(fields: [cashierId], references: [id])
  number            String
  type              SaleType             @default(SALE)
  status            SaleStatus           @default(DRAFT)
  subtotal          Decimal              @db.Decimal(12, 2)
  discountAmount    Decimal              @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal              @default(0) @db.Decimal(12, 2)
  insuranceAmount   Decimal              @default(0) @db.Decimal(12, 2)
  // Assureur qui prend en charge insuranceAmount (suivi des paiements trimestriels).
  insurerId         String?
  insurer           Insurer?             @relation(fields: [insurerId], references: [id])
  // Date à laquelle le remboursement de l'assureur a été effectivement reçu
  // (marqué manuellement) : distingue le "recouvré" du simplement "attendu"
  // dans le widget Assurances du tableau de bord.
  insurerPaidAt     DateTime?
  // Montant réellement reçu de l'assureur. Permet les remboursements partiels
  // avant le solde complet de la prise en charge.
  insurerPaidAmount Decimal              @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal              @db.Decimal(12, 2)
  paidAmount        Decimal              @default(0) @db.Decimal(12, 2)
  currency          String               @default("XOF")
  // Garantie accordée sur l'équipement vendu (monture/verres) : durée en mois
  // et date d'échéance figée à la vente, pour trancher un litige en SAV.
  warrantyMonths    Int?
  warrantyEndsAt    DateTime?
  // Remise accordée en points de fidélité (montant déjà inclus dans discountAmount).
  loyaltyPointsUsed Int                  @default(0)
  // Ordonnance jointe au devis / à la vente (facultatif) : reprise sur le
  // document imprimé pour que le client ait tout sur une seule page.
  prescriptionId    String?
  prescription      OpticalPrescription? @relation(fields: [prescriptionId], references: [id])
  // Retour/avoir : référence la vente d'origine remboursée.
  originalSaleId    String?
  originalSale      Sale?                @relation("SaleReturns", fields: [originalSaleId], references: [id])
  returns           Sale[]               @relation("SaleReturns")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  items    SaleItem[]
  payments Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, branchId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([insurerId])
  @@index([prescriptionId])
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)
  // Référence libre saisie à la vente (ex. référence fabricant d'une monture),
  // indépendante du stock : plusieurs articles peuvent partager la même fiche
  // produit/prix au catalogue sans qu'on ait à créer un SKU par référence.
  reference String? @db.VarChar(80)

  @@index([saleId])
}

/**
 * Commande de verres/montures auprès d'un laboratoire ou fournisseur.
 */
model LensOrder {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number         String
  customerId     String?
  customer       Customer?       @relation(fields: [customerId], references: [id])
  category       String? // VERRES | LENTILLES | ACCESSOIRE | MONTURE | AUTRE
  supplierName   String? // laboratoire / fournisseur
  description    String // ex. « Verres progressifs 1.6 anti-reflet »
  // Détail par œil (catégorie VERRES) : affiché tel quel sur la carte Kanban.
  odLens         String?
  ogLens         String?
  // Monture associée (facultative) : sert de vignette sur la carte Kanban.
  frameProductId String?
  frameProduct   Product?        @relation(fields: [frameProductId], references: [id], onDelete: SetNull)
  status         LensOrderStatus @default(TO_ORDER)
  expectedAt     DateTime?
  deliveredAt    DateTime? // date de remise au client (calcul du délai de livraison)
  // Dernier rappel WhatsApp envoyé au client depuis la fiche commande.
  notifiedAt     DateTime?
  cost           Decimal?        @db.Decimal(12, 2)
  notes          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  /// Configuration structurée (catégorie VERRES) : type, matériau, indice,
  /// traitements, prescription OD/OG, détail du prix. null = anciennes
  /// commandes ou catégories non-verres — l'app retombe alors sur
  /// description/odLens/ogLens/cost comme avant, sans aucun changement.
  lensConfig     Json?

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([frameProductId])
}

/**
 * Réparation / SAV d'une monture ou d'un équipement.
 */
model Repair {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  number      String
  customerId  String?
  customer    Customer?    @relation(fields: [customerId], references: [id])
  category    String? // MONTURE | VERRE | VIS | PLAQUETTES | NETTOYAGE | AUTRE
  description String
  status      RepairStatus @default(RECEIVED)
  cost        Decimal?     @db.Decimal(12, 2)
  notes       String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

/**
 * ---------------- PAYMENTS (CinetPay-ready) ----------------
 */

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  MTN_MOMO
  MOOV_MONEY
  FREE_MONEY
  CARD
  /// Cheque : surtout utilise par les assurances (tiers payant).
  CHEQUE
  // Marchés lusophones (encaissement manuel au comptoir)
  MPESA
  EMOLA
  MKESH
  MULTICAIXA
  UNITEL_MONEY
  VINTI4
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

model Payment {
  id          String        @id @default(uuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  saleId      String
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  provider    String? // "cinetpay" | "manual" | "simulation"
  providerRef String?
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("XOF")
  rawPayload  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  transactions Transaction[]

  @@index([tenantId, saleId])
  @@index([provider, providerRef])
}

model Transaction {
  id        String        @id @default(uuid())
  paymentId String
  payment   Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  event     String
  status    PaymentStatus
  payload   Json?
  createdAt DateTime      @default(now())

  @@index([paymentId])
}

/**
 * ---------------- CASH REGISTER ----------------
 */

enum CashRegisterStatus {
  OPEN
  CLOSED
}

model CashRegister {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch             @relation(fields: [branchId], references: [id])
  openedById     String
  openedAt       DateTime           @default(now())
  closedById     String?
  closedAt       DateTime?
  openingAmount  Decimal            @db.Decimal(12, 2)
  closingAmount  Decimal?           @db.Decimal(12, 2)
  expectedAmount Decimal?           @db.Decimal(12, 2)
  status         CashRegisterStatus @default(OPEN)

  @@index([tenantId, branchId, status])
}

/**
 * ---------------- AUDIT ----------------
 */

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId])
}

/**
 * ---------------- CLINIQUE (Phase 2) ----------------
 */

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Eye {
  OD
  OG
  OU
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SurgeryStatus {
  PLANNED
  DONE
  CANCELLED
}

model Patient {
  id             String    @id @default(uuid())
  tenantId       String
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  gender         Gender?
  dateOfBirth    DateTime?
  phone          String?
  email          String?
  address        String?
  bloodGroup     String?
  allergies      String?
  medicalHistory String?
  // Une même personne peut être cliente de l'optique et patiente de la clinique.
  customerId     String?   @unique
  customer       Customer? @relation("CustomerPatient", fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  consultations Consultation[]
  appointments  Appointment[]
  surgeries     Surgery[]

  @@index([tenantId])
}

model Consultation {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitionerName  String?
  date              DateTime @default(now())
  visualAcuityRight String?
  visualAcuityLeft  String?
  refractionRight   String?
  refractionLeft    String?
  tonometryRight    String?
  tonometryLeft     String?
  biomicroscopy     String?
  fundus            String?
  oct               String?
  visualField       String?
  diagnosis         String?
  prescription      String?
  lensType          String?
  notes             String?
  createdById       String?
  createdAt         DateTime @default(now())

  @@index([tenantId, patientId])
  @@index([tenantId])
}

/// Réservation de démonstration gratuite demandée depuis le tableau de bord par
/// un établissement en essai ou sans abonnement actif. Consultée dans la console
/// fondateur (non isolée par tenant : suivi commercial global). Le nom de
/// l'établissement est figé à la création pour l'affichage.
model DemoRequest {
  id           String   @id @default(uuid())
  tenantId     String?
  tenantName   String?
  contactName  String
  contactEmail String
  contactPhone String?
  preferredAt  DateTime
  notes        String?
  status       String   @default("PENDING")
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model Appointment {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitionerName String?
  scheduledAt      DateTime
  reason           String?
  status           AppointmentStatus @default(SCHEDULED)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([tenantId, scheduledAt])
  @@index([tenantId])
}

model Surgery {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type          String
  eye           Eye           @default(OU)
  surgeonName   String?
  scheduledAt   DateTime?
  status        SurgeryStatus @default(PLANNED)
  outcome       String?
  followUpNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId, patientId])
  @@index([tenantId])
}

/**
 * ---------------- GESTION (Phase 2) ----------------
 */

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

/// Sens d'un versement : argent entrant dans la boutique (apport) ou
/// sortant du tiroir-caisse sans être une charge (dépôt en banque, remise
/// au propriétaire).
enum TransferDirection {
  IN
  OUT
}

/// Mouvement d'argent qui n'est ni une vente ni une charge d'exploitation :
/// apports et retraits de caisse, suivis par boutique.
model CashTransfer {
  id          String            @id @default(uuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  direction   TransferDirection
  label       String
  amount      Decimal           @db.Decimal(12, 2)
  date        DateTime          @default(now())
  branchId    String?
  notes       String?
  createdById String?
  createdAt   DateTime          @default(now())

  @@index([tenantId, date])
  @@index([tenantId, branchId])
}

enum ExpenseCategory {
  RENT
  SALARIES
  ELECTRICITY
  WATER
  INTERNET
  MARKETING
  TRANSPORT
  SUPPLIES
  MAINTENANCE
  TAXES
  OTHER
}

enum SupplierType {
  LOCAL
  INTERNATIONAL
}

enum InsurerType {
  HEALTH_INSURANCE
  MUTUAL
  PRIVATE
  THIRD_PARTY
}

model Employee {
  id        String         @id @default(uuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
  email     String?
  position  String
  salary    Decimal?       @db.Decimal(12, 2)
  hireDate  DateTime?
  status    EmployeeStatus @default(ACTIVE)
  branchId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([tenantId])
}

model Expense {
  id          String          @id @default(uuid())
  tenantId    String
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  label       String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  branchId    String?
  notes       String?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([tenantId, date])
  @@index([tenantId])
}

model Supplier {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  type        SupplierType @default(LOCAL)
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  stockMovements StockMovement[]

  @@index([tenantId])
}

model Insurer {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  type            InsurerType @default(HEALTH_INSURANCE)
  coveragePercent Int         @default(0)
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sales Sale[]

  @@index([tenantId])
}

/**
 * ---------------- ABONNEMENTS SaaS ----------------
 */

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubInvoiceStatus {
  PENDING
  PAID
  FAILED
  VOID
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  code         String   @unique // TRIAL | STANDARD | PREMIUM
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(12, 2)
  currency     String   @default("XOF")
  trialDays    Int      @default(0)
  maxUsers     Int? // null = illimité
  maxBranches  Int?
  maxPatients  Int?
  maxSales     Int?
  features     Json?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @unique
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId             String
  plan               SubscriptionPlan   @relation(fields: [planId], references: [id])
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  autoRenew          Boolean            @default(true)
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  invoices SubscriptionInvoice[]

  @@index([status])
}

model SubscriptionInvoice {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String
  number         String
  amount         Decimal          @db.Decimal(12, 2)
  currency       String           @default("XOF")
  status         SubInvoiceStatus @default(PENDING)
  periodStart    DateTime
  periodEnd      DateTime
  // Nombre de mois couverts par cette facture (1 = mensuel, 6 = paiement
  // groupé 6 mois avec remise) : source de vérité pour prolonger l'abonnement
  // du bon nombre de mois au règlement (settleSubscriptionPayment), y compris
  // après un délai (webhook asynchrone).
  periodMonths   Int              @default(1)
  dueDate        DateTime
  paidAt         DateTime?
  createdAt      DateTime         @default(now())

  payments SubscriptionPayment[]

  @@unique([tenantId, number])
  @@index([tenantId])
}

model SubscriptionPayment {
  id          String              @id @default(uuid())
  tenantId    String
  invoiceId   String
  invoice     SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  method      PaymentMethod
  provider    String?
  providerRef String?
  // Canal choisi pour un règlement manuel ('MOBILE_MONEY' | 'BANK_TRANSFER'),
  // pour que le fondateur sache où chercher le paiement à confirmer. null pour
  // les paiements via passerelle (non manuels).
  channel     String?
  status      PaymentStatus       @default(PENDING)
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("XOF")
  rawPayload  Json?
  // Contexte Meta Conversions API capturé à l'initiation (ip/UA/fbp/fbc),
  // réutilisé à la confirmation (souvent asynchrone, via webhook) pour un
  // évènement Purchase correctement attribué.
  capiContext Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([tenantId])
  @@index([provider, providerRef])
}

model SupportTicket {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN | CLOSED
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId])
}

/// Équipe de l'éditeur ayant accès à la console fondateur (cross-tenant).
/// S'ajoute aux emails de PLATFORM_ADMIN_EMAILS (bootstrap via env), sans les
/// remplacer : retirer une ligne ici ne révoque pas un email listé dans l'env.
model PlatformOperator {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  addedById String?
  createdAt DateTime @default(now())
}

/// Notifications de la console fondateur (cross-tenant), ex. nouvel
/// établissement créé. tenantId en référence libre (comme DemoRequest, pas de
/// contrainte FK) : l'historique reste lisible même si le tenant est supprimé.
model PlatformNotification {
  id         String    @id @default(uuid())
  type       String
  tenantId   String?
  tenantName String?
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

/// Réglages globaux de la plateforme (ligne unique, id fixe "default"). Pour
/// l'instant : durée de l'essai gratuit offert à l'inscription, ajustable
/// depuis la console fondateur sans redéploiement.
model PlatformSettings {
  id                   String   @id @default("default")
  trialDurationMinutes Int      @default(120)
  updatedAt            DateTime @updatedAt
}

/**
 * ---------------- CHATBOT WHATSAPP ----------------
 */

/// Prospect ayant écrit au chatbot commercial WhatsApp. Cross-tenant : ce sont
/// des leads du fondateur, non rattachés à un établissement. Alimenté par le
/// webhook WhatsApp Cloud API (module whatsapp) via le client Prisma système.
model WhatsappContact {
  id            String   @id @default(uuid())
  /// Numéro au format wa_id (ex. "2250596609036", sans « + »).
  phone         String   @unique
  /// Nom du profil WhatsApp du prospect (fourni par Meta).
  profileName   String?
  /// true = le fondateur a repris la main → le bot n'auto-répond plus à ce contact.
  botPaused     Boolean  @default(false)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages WhatsappMessage[]

  @@index([lastMessageAt])
}

/// Un message de la conversation (entrant ou réponse du bot). Sert de mémoire
/// pour poser les questions de qualification une par une, dans l'ordre.
model WhatsappMessage {
  id          String          @id @default(uuid())
  contactId   String
  contact     WhatsappContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  /// 'user' (prospect) | 'assistant' (bot).
  role        String
  text        String
  /// Identifiant Meta du message entrant (déduplication des redistributions).
  waMessageId String?
  createdAt   DateTime        @default(now())

  @@index([contactId, createdAt])
  @@index([waMessageId])
}

/// Progression d'un utilisateur sur une vidéo de démonstration commerciale.
/// Sert à reprendre où il s'est arrêté ET à mesurer l'intérêt d'un prospect
/// (console fondateur : qui rappeler en priorité).
model DemoVideoProgress {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "1".."4" — identifiant de la vidéo dans le parcours.
  videoKey            String
  /// Position exacte de reprise (secondes).
  lastPositionSeconds Int       @default(0)
  durationSeconds     Int?
  /// MEILLEUR pourcentage atteint : ne redescend jamais quand l'utilisateur
  /// revient en arrière. C'est lui qui mesure l'intérêt, pas la position courante.
  maxPercent          Int       @default(0)
  viewCount           Int       @default(0)
  completedAt         DateTime?
  /// Réponse au questionnaire de compréhension : YES | UNSURE | NO.
  understood          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, videoKey])
  @@index([tenantId])
}

/**
 * ---------------- CRM PROSPECTION (console fondateur) ----------------
 */

enum ProspectStatus {
  NEW
  CONTACTED
  REPLIED
  DEMO_SCHEDULED
  DEMO_COMPLETED
  TRIAL
  CUSTOMER
  LOST
}

enum ProspectSegment {
  DISCOVERY
  STANDARD
  PREMIUM
}

enum ProspectPriority {
  LOW
  MEDIUM
  HIGH
  HOT
}

enum ProspectSource {
  IMPORT_EXCEL
  FACEBOOK_ADS
  WHATSAPP
  LANDING_PAGE
  DEMO
  REFERRAL
  MANUAL
}

/// Joignabilité WhatsApp. Meta n'expose aucun moyen officiel de savoir si un
/// numéro possède WhatsApp sans lui écrire : le statut VERIFIED n'est donc
/// JAMAIS déduit du format, il vient d'une preuve réelle (le prospect a
/// répondu) ou d'un marquage manuel du fondateur.
enum WhatsappStatus {
  WHATSAPP_VERIFIED
  PHONE_VALID_WHATSAPP_UNCONFIRMED
  PHONE_INVALID
  VERIFICATION_FAILED
}

/// Prospect commercial (opticien démarché). Données strictement privées au
/// fondateur : aucune relation avec Tenant, aucun accès client possible.
model Prospect {
  id                String  @id @default(uuid())
  firstName         String?
  lastName          String?
  establishmentName String
  /// Numéro tel que saisi/importé (conservé pour affichage et contrôle).
  phone             String?
  /// Numéro normalisé E.164 — clé de déduplication.
  phoneNormalized   String? @unique
  phoneCountry      String?
  email             String?
  country           String?
  city              String?
  address           String?
  website           String?

  segment       ProspectSegment  @default(STANDARD)
  leadScore     Int              @default(0)
  /// Score forcé par le fondateur : quand il est posé, le calcul auto ne l'écrase plus.
  scoreOverride Int?
  priority      ProspectPriority @default(MEDIUM)
  status        ProspectStatus   @default(NEW)
  source        ProspectSource   @default(IMPORT_EXCEL)

  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?
  demoDate        DateTime?
  demoCompletedAt DateTime?
  trialStartDate  DateTime?
  trialEndDate    DateTime?
  convertedAt     DateTime?
  notes           String?

  whatsappStatus            WhatsappStatus @default(PHONE_VALID_WHATSAPP_UNCONFIRMED)
  whatsappVerifiedAt        DateTime?
  whatsappVerificationError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ProspectEvent[]

  @@index([status])
  @@index([priority])
  @@index([country, city])
  @@index([nextFollowUpAt])
}

/// Historique horodaté d'un prospect (timeline de la fiche).
model ProspectEvent {
  id          String   @id @default(uuid())
  prospectId  String
  prospect    Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  /// IMPORTED | STATUS_CHANGED | CONTACTED | NOTE | FOLLOW_UP | WHATSAPP_MARKED
  type        String
  label       String
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([prospectId, createdAt])
}

/// Modèle de message WhatsApp réutilisable (variables {{first_name}}...).
model ProspectMessageTemplate {
  id        String   @id @default(uuid())
  /// Clé stable des modèles livrés par défaut (FIRST_CONTACT, FOLLOW_UP_2...).
  key       String   @unique
  name      String
  body      String
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Réglages CRM (ligne unique) : URLs de conversion jamais codées en dur.
model CrmSettings {
  id             String   @id @default("default")
  demoVideosUrl  String?
  signupUrl      String?
  demoBookingUrl String?
  updatedAt      DateTime @updatedAt
}

/**
 * ---------------- OCULO PARTNERS ----------------
 *
 * Ces modèles sont globaux : un partenaire n'est pas un utilisateur d'un
 * magasin et ne doit jamais être soumis au client Prisma tenant-scopé.
 */

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerTierCode {
  AMBASSADOR
  PARTNER_PRO
  PARTNER_EXPERT
}

enum PartnerLeadStatus {
  NEW
  CONTACTED
  DEMO
  TRIAL
  SUBSCRIBED
  LOST
}

enum PartnerCommissionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  CANCELLED
  REVERSED
}

model Partner {
  id              String            @id @default(uuid())
  firstName       String
  lastName        String
  email           String            @unique
  whatsapp        String            @unique
  countryCode     String?
  city            String?
  passwordHash    String
  referralCode    String            @unique
  status          PartnerStatus     @default(PENDING)
  tier            PartnerTierCode   @default(AMBASSADOR)
  payoutMethod    String?
  payoutDetails   Json?
  termsAcceptedAt DateTime
  approvedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  sessions     PartnerSession[]
  attributions PartnerAttribution[]
  leads        PartnerLead[]
  commissions  PartnerCommission[]
  auditLogs    PartnerAuditLog[]
}

model PartnerSession {
  id         String   @id @default(uuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([partnerId])
}

/// Attribution durable : un tenant ne peut appartenir qu'à un partenaire.
model PartnerAttribution {
  id          String   @id @default(uuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  referralCode String
  visitorId   String?
  tenantId    String?  @unique
  emailHash   String?
  firstSeenAt DateTime @default(now())
  expiresAt   DateTime
  linkedAt    DateTime?
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerId, expiresAt])
  @@index([referralCode])
  @@index([visitorId])
}

model PartnerLead {
  id                String            @id @default(uuid())
  partnerId         String
  partner           Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  establishmentName String
  contactName       String?
  phone             String?
  email             String?
  countryCode       String?
  city              String?
  source            String            @default("MANUAL")
  status            PartnerLeadStatus @default(NEW)
  tenantId          String?           @unique
  lastActivityAt    DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([partnerId, status])
}

/// Règle serveur : montant fixe par offre et niveau partenaire, jamais frontend.
model PartnerCommissionRule {
  id            String          @id @default(uuid())
  planCode      String
  tier          PartnerTierCode
  amount        Decimal         @db.Decimal(12, 2)
  currency      String          @default("XOF")
  isActive      Boolean         @default(true)
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([planCode, tier, isActive])
}

/// Une commission par premier paiement d'abonnement, garantie par l'unicité.
model PartnerCommission {
  id                    String                  @id @default(uuid())
  partnerId             String
  partner               Partner                 @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  tenantId              String
  subscriptionPaymentId String                  @unique
  subscriptionInvoiceId String                  @unique
  planCode              String
  customerAmount        Decimal                 @db.Decimal(12, 2)
  amount                Decimal                 @db.Decimal(12, 2)
  currency              String                  @default("XOF")
  status                PartnerCommissionStatus @default(PENDING)
  ruleSnapshot          Json
  approvedAt            DateTime?
  payableAt             DateTime?
  paidAt                DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([partnerId, status])
  @@index([tenantId])
}

model PartnerEvent {
  id             String   @id @default(uuid())
  type           String
  idempotencyKey String   @unique
  payload        Json
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([type, createdAt])
}

model PartnerAuditLog {
  id        String   @id @default(uuid())
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  actorType String
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([partnerId, createdAt])
  @@index([action, createdAt])
}
