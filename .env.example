# ============================================================
# OculoSaaS — Variables d'environnement (modèle)
# Copier vers apps/api/.env et remplir les valeurs.
# NE JAMAIS committer le vrai .env (il est dans .gitignore).
# ============================================================

# --- Base de données ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/oculo_dev?schema=public"

# --- Serveur API ---
API_PORT=4000
NODE_ENV=development

# --- CORS / Cookies (frontend Vite) ---
CORS_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false
# 'strict' en local. En cross-domaine (frontend et API sur des domaines différents,
# ex. Vercel + Render) : COOKIE_SAMESITE=none, COOKIE_SECURE=true, COOKIE_DOMAIN="".
COOKIE_SAMESITE=strict

# --- JWT ---
# En production : utiliser des secrets longs et aléatoires (32+ octets).
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-0123456789"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# --- Chiffrement au repos (config CinetPay, etc.) ---
# Doit faire exactement 64 caractères hexadécimaux (32 octets) pour AES-256-GCM.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# --- Mailer ---
# MAIL_DRIVER=console : les emails (reset password) sont logués dans la console (dev).
# MAIL_DRIVER=smtp : utilise les variables SMTP_* ci-dessous (prod).
MAIL_DRIVER=console
MAIL_FROM="OculoSaaS <no-reply@oculosaas.africa>"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# --- Sécurité auth ---
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# --- GeniusPay (orchestrateur multi-passerelles, 23 pays africains) ---
# Encaisse les ABONNEMENTS de la plateforme. Passe APRES Moneroo depuis le
# 2026-08-25 (pannes cote clients, paiements bloques) : ne sert que si Moneroo
# n'est pas configure. Remettre en tete (voir platform-provider.ts) une fois
# l'incident GeniusPay resolu, pour la couverture Maghreb/Afrique de l'Est.
# Cles dans le tableau de bord GeniusPay > Parametres > API.
# L'environnement se lit dans le PREFIXE des cles : pk_sandbox_ pour tester sans
# argent reel, pk_live_ pour encaisser. Il n'y a pas de variable ENV separee.
GENIUSPAY_API_KEY=""
GENIUSPAY_API_SECRET=""
# Secret du webhook (whsec_...), DIFFERENT des cles d'API ci-dessus. Sans lui,
# les webhooks sont refuses : impossible de distinguer un vrai d'un faux.
GENIUSPAY_WEBHOOK_SECRET=""
GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"
# Webhook a enregistrer une fois chez GeniusPay (POST /webhooks), evenements
# payment.success / payment.failed / payment.cancelled / payment.expired :
#   <PUBLIC_API_URL>/webhooks/geniuspay-subscription

# --- PayTech (passerelle de paiement Wave / Orange Money / Free Money / cartes) ---
# Clés plateforme (Dashboard PayTech > API & APN). Encaissent les ABONNEMENTS.
# Tant que PAYTECH_API_KEY est vide → mode simulation.
PAYTECH_API_KEY=""
PAYTECH_API_SECRET=""
# 'test' pour valider sans argent réel, 'prod' pour encaisser réellement.
PAYTECH_ENV="prod"
PAYTECH_BASE_URL="https://paytech.sn/api"
# URL publique de l'API, utilisée pour les notifications IPN PayTech.
# Ex : https://oculosaas-api.onrender.com
PUBLIC_API_URL=""

# --- Moneroo (orchestrateur multi-passerelles) — PRIORITAIRE depuis le 2026-08-25 ---
# Encaisse les ABONNEMENTS de la plateforme. Redevenu le fournisseur par defaut
# suite a des pannes cote GeniusPay (clients bloques a la caisse). Cle secrete
# dans le tableau de bord Moneroo > Developpeur > Cles API.
MONEROO_SECRET_KEY=""
MONEROO_BASE_URL="https://api.moneroo.io/v1"
# Secret de verification des webhooks (tableau de bord Moneroo > Webhooks).
MONEROO_WEBHOOK_SECRET=""
# Webhook a enregistrer chez Moneroo : <PUBLIC_API_URL>/webhooks/moneroo-subscription

# --- Encaissement MANUEL des abonnements (depot direct + confirmation manuelle) ---
# Toujours propose en plus d'une passerelle en ligne, et seule option si aucune
# n'est configuree. Le client depose sur le numero/compte ci-dessous puis clique
# « J'ai payé » ; le fondateur confirme depuis la console (onglet « À confirmer »)
# pour activer l'abonnement. Laisser vide pour desactiver un canal.
PLATFORM_PAY_NUMBER=""
PLATFORM_PAY_NAME=""
PLATFORM_PAY_NETWORK=""
PLATFORM_BANK_NAME=""
PLATFORM_BANK_ACCOUNT_NAME=""
PLATFORM_BANK_ACCOUNT_NUMBER=""
PLATFORM_BANK_SWIFT=""

# --- CinetPay (déprécié — conservé pour compatibilité) ---
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_BASE_URL="https://api-checkout.cinetpay.com/v2"
CINETPAY_WEBHOOK_SECRET=""

# --- Frontend (apps/web/.env) ---
# VITE_API_URL="http://localhost:4000"
# VITE_SUPABASE_URL="https://xxx.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJ..."
# VITE_SUPABASE_BUCKET="OCL 4"

